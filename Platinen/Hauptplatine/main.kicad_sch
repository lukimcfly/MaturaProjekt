	(text "F901/F902 begrenzen den Strom bei einem Kurzschluss.\nD907/D908 (Schottky) sperren, wenn der Netzstecker verpolt ist:\n+12 V und -12 V koennen dann nicht vertauscht an die ICs gelangen.\nSpannungsverlust ca. 0,3 V pro Schiene."
		(exclude_from_sim no)
		(at 600.71 900.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
